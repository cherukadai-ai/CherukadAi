# Copy to backend/.env for local (non-Docker) `uvicorn app.main:app` runs.
# NEVER commit a real .env file.

ENVIRONMENT=local
DEBUG=true
SECRET_KEY=change-me-generate-a-long-random-value
SESSION_COOKIE_NAME=cherukadai_session
ALLOWED_ORIGINS=http://localhost:3000

DATABASE_URL=postgresql+asyncpg://cherukadai:cherukadai@localhost:5432/cherukadai
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=cherukadai-files

OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=

LOG_LEVEL=INFO
LOG_JSON=false

SUPER_ADMIN_SETUP_TOKEN=
