# Copy to .env and fill in real values for local Docker Compose usage.
# NEVER commit a real .env file. This file must only ever contain placeholders.

# --- Postgres ---
POSTGRES_USER=cherukadai
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=cherukadai

# --- Backend (app/core/config.py Settings) ---
ENVIRONMENT=local
DEBUG=true
SECRET_KEY=change-me-generate-a-long-random-value
SESSION_COOKIE_NAME=cherukadai_session
ALLOWED_ORIGINS=http://localhost:3000

DATABASE_URL=postgresql+asyncpg://cherukadai:change-me-local-only@localhost:5432/cherukadai
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Azure Blob Storage (leave blank locally; Azurite/dev abstraction used instead) ---
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=cherukadai-files

# --- AI Providers (never commit real keys) ---
OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=

LOG_LEVEL=INFO
LOG_JSON=true

# Set only for the one-time Super Admin bootstrap (a future phase); leave unset otherwise.
SUPER_ADMIN_SETUP_TOKEN=

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_NAME=CherukadAI Platform
